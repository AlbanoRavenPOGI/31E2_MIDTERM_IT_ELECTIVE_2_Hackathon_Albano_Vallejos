@model RSVPSystem.Models.EventModel
@{
    ViewData["Title"] = Model.Title;
    var rsvps = ViewBag.Rsvps as List<RSVPSystem.Models.RsvpModel> ?? new List<RSVPSystem.Models.RsvpModel>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Event Details & Images -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
            <img src="@Model.ImagePath" class="card-img-top" style="height: 260px; object-fit: cover;" alt="@Model.EventType"
                 onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?w=800';" />

            <div class="card-body p-4">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">@Model.EventType Event</span>
                <h2 class="fw-bold text-dark mb-2">@Model.Title</h2>
                <p class="text-muted">@Model.Description</p>

                <hr class="my-4" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="fa-solid fa-user-tie me-2 text-primary"></i>Host Name</h6>
                            <p class="fw-bold mb-0">@Model.HostName</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="fa-solid fa-calendar-day me-2 text-primary"></i>Date</h6>
                            <p class="fw-bold mb-0">@Model.EventDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i>Place / Venue</h6>
                            <p class="fw-bold mb-0">@Model.Venue</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="fa-solid fa-users me-2 text-success"></i>Max Guests</h6>
                            <p class="fw-bold mb-0">@Model.VisitorCapacity People</p>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="text-muted text-uppercase small fw-bold mb-1"><i class="fa-solid fa-utensils me-2 text-warning"></i>Food & Menu</h6>
                            <p class="fw-bold mb-0">@Model.FoodMenu</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: RSVP Form for Guests -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 p-4">
            <h4 class="fw-bold mb-2"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>RSVP Now</h4>
            <p class="text-muted small mb-4">Confirm your presence for @Model.HostName's event.</p>

            <form asp-controller="Event" asp-action="SubmitRsvp" method="post">
                <input type="hidden" name="EventId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Your Full Name</label>
                    <input type="text" name="GuestName" class="form-control rounded-3" placeholder="John Doe" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Your Email</label>
                    <input type="email" name="Email" class="form-control rounded-3" placeholder="john@example.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Will you attend?</label>
                    <select name="Status" class="form-select rounded-3">
                        <option value="Attending">Yes, Attending 🎉</option>
                        <option value="Declined">Cannot Attend 😞</option>
                        <option value="Maybe">Maybe 🤔</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Visitor / Guest Count</label>
                    <input type="number" name="GuestCount" class="form-control rounded-3" value="1" min="1" max="10" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">Submit Response</button>
            </form>

            <div class="mt-4 pt-3 border-top">
                <a asp-controller="Home" asp-action="Dashboard" class="btn btn-light w-100 rounded-3">
                    <i class="fa-solid fa-house me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>