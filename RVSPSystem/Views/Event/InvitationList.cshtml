@model IEnumerable<RSVPSystem.Models.EventModel>

@{
    ViewData["Title"] = "Invitations";
}

<h2 class="fw-bold mb-4">

    Available Invitations

</h2>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-body">

                    <h4>

                        @item.Title

                    </h4>

                    <p>

                        <strong>Type:</strong>

                        @item.EventType

                    </p>

                    <p>

                        <strong>Date:</strong>

                        @item.EventDate.ToString("MMMM dd, yyyy")

                    </p>

                    <a asp-action="Invitation"
                       asp-route-id="@item.Id"
                       class="btn btn-primary w-100">

                        View Invitation

                    </a>

                </div>

            </div>

        </div>
    }

</div>

<div class="text-end">

    <a asp-controller="Account"
       asp-action="Logout"
       class="btn btn-danger">

        Logout

    </a>

</div>