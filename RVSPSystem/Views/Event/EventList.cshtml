@model IEnumerable<RSVPSystem.Models.EventModel>
@{
    ViewData["Title"] = "Created Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Created Events</h2>
        <p class="text-muted m-0">Click on any event to view details, venue, food, and visitor RSVPs.</p>
    </div>
    <a asp-action="CreateEventPage" class="btn btn-primary rounded-3">
        <i class="fa-solid fa-plus me-1"></i> New Event
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 hover-shadow">
                <img src="@ev.ImagePath" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@ev.EventType"
                     onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?w=600';" />

                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1 rounded-2">@ev.EventType</span>
                    </div>
                    <h5 class="card-title fw-bold text-dark">@ev.Title</h5>

                    <ul class="list-unstyled text-muted small my-3 flex-grow-1">
                        <li class="mb-1"><i class="fa-solid fa-user me-2 text-secondary"></i>Host: <strong>@ev.HostName</strong></li>
                        <li class="mb-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i>Place: @ev.Venue</li>
                        <li class="mb-1"><i class="fa-solid fa-users me-2 text-success"></i>Capacity: @ev.VisitorCapacity visitors</li>
                        <li class="mb-1"><i class="fa-solid fa-utensils me-2 text-warning"></i>Food: @ev.FoodMenu</li>
                        <li><i class="fa-solid fa-calendar me-2 text-info"></i>Date: @ev.EventDate.ToString("MMM dd, yyyy")</li>
                    </ul>

                    <a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline-primary w-100 rounded-3 mt-2 fw-semibold">
                        View Event Page <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>