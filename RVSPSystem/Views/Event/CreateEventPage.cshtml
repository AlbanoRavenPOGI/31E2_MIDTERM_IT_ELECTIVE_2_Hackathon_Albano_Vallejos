@model RSVPSystem.Models.EventModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 p-4">
            <h3 class="fw-bold mb-3"><i class="fa-solid fa-calendar-plus text-primary me-2"></i>Create New Event</h3>

            <form asp-controller="Event" asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Event Title</label>
                    <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. John & Jane's Wedding" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label fw-semibold">Event Category</label>
                    <select asp-for="EventType" class="form-select rounded-3">
                        <option value="Wedding">Wedding 💍</option>
                        <option value="Birthday">Birthday 🎂</option>
                        <option value="Christening">Christening 👶</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-semibold">Event Date</label>
                    <input asp-for="EventDate" class="form-control rounded-3" type="date" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold">Description / Note</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Location, dress code, info..."></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-light rounded-3">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Save Event</button>
                </div>
            </form>
        </div>
    </div>
</div>