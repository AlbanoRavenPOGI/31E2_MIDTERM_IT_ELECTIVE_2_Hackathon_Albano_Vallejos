@model RSVPSystem.Models.EventModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 p-4">
            <h3 class="fw-bold mb-4 text-primary"><i class="fa-solid fa-calendar-plus me-2"></i>Create New Event</h3>

            <form asp-controller="Event" asp-action="Create" method="post">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label fw-semibold">Event Title</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. John's 18th Birthday" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label fw-semibold">Event Type</label>
                        <select asp-for="EventType" class="form-select rounded-3">
                            <option value="Wedding">Wedding 💍</option>
                            <option value="Birthday">Birthday 🎂</option>
                            <option value="Christening">Christening 👶</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HostName" class="form-label fw-semibold">Host Name(s)</label>
                        <input asp-for="HostName" class="form-control rounded-3" placeholder="e.g. The Santos Family" />
                        <span asp-validation-for="HostName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VisitorCapacity" class="form-label fw-semibold">Visitor / Guest Capacity</label>
                        <input asp-for="VisitorCapacity" class="form-control rounded-3" type="number" />
                        <span asp-validation-for="VisitorCapacity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Venue" class="form-label fw-semibold">Venue / Place</label>
                        <input asp-for="Venue" class="form-control rounded-3" placeholder="e.g. Sunset Pavilion, Beach Resort" />
                        <span asp-validation-for="Venue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EventDate" class="form-label fw-semibold">Event Date</label>
                        <input asp-for="EventDate" class="form-control rounded-3" type="date" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FoodMenu" class="form-label fw-semibold">Foods / Menu Served</label>
                        <input asp-for="FoodMenu" class="form-control rounded-3" placeholder="e.g. Catering Italian Buffet & Desserts" />
                        <span asp-validation-for="FoodMenu" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">Special Instructions / Details</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Dress code, agenda, parking details..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">Save & View Event</button>
                </div>
            </form>
        </div>
    </div>
</div>