@model IEnumerable<RSVPSystem.Models.RsvpModel>
@{
    ViewData["Title"] = "RSVP Submissions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="fa-solid fa-list-check text-success me-2"></i>Guest Responses</h3>
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary rounded-3">Back to Dashboard</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Guest Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Count</th>
                    <th>Submitted On</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No RSVPs received yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.GuestName</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Status == "Attending")
                                {
                                    <span class="badge bg-success">Attending</span>
                                }
                                else if (item.Status == "Declined")
                                {
                                    <span class="badge bg-danger">Declined</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Maybe</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.GuestCount</span></td>
                            <td class="small text-muted">@item.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>