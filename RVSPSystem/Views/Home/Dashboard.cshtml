@using RSVPSystem.Data
@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">Welcome Admin 👋</h2>
        <p class="text-muted m-0">Manage your events and live guest RSVP updates.</p>
    </div>
    <a asp-controller="Event" asp-action="CreateEventPage" class="btn btn-primary rounded-3 px-3">
        <i class="fa-solid fa-plus me-1"></i> New Event
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1">Total Events</h6>
                    <h2 class="fw-bold mb-0">@DataStore.Events.Count</h2>
                </div>
                <i class="fa-solid fa-calendar-days fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold mb-1">Total RSVPs Received</h6>
                    <h2 class="fw-bold mb-0">@DataStore.Rsvps.Count</h2>
                </div>
                <i class="fa-solid fa-users fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="mb-3 text-primary"><i class="fa-solid fa-calendar-plus fa-3x"></i></div>
                <h4 class="card-title fw-bold">Create Event</h4>
                <p class="card-text text-muted">Setup weddings, birthdays, or christening events easily.</p>
                <a asp-controller="Event" asp-action="CreateEventPage" class="btn btn-outline-primary w-100 rounded-3">Open Form</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="mb-3 text-success"><i class="fa-solid fa-clipboard-user fa-3x"></i></div>
                <h4 class="card-title fw-bold">RSVP List</h4>
                <p class="card-text text-muted">View live attendee lists and guest numbers.</p>
                <a asp-controller="Event" asp-action="RsvpList" class="btn btn-outline-success w-100 rounded-3">View Guest List</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="mb-3 text-danger"><i class="fa-solid fa-right-from-bracket fa-3x"></i></div>
                <h4 class="card-title fw-bold">Logout</h4>
                <p class="card-text text-muted">Safely end your session.</p>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger w-100 rounded-3">Logout</a>
            </div>
        </div>
    </div>
</div>