@using RSVPSystem.Data

@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">
            Welcome Admin 👋
        </h2>

        <p class="text-muted">
            Manage your invitations and RSVP responses.
        </p>
    </div>

    <a asp-controller="Event"
       asp-action="CreateEventPage"
       class="btn btn-primary">

        New Event

    </a>

</div>

<div class="row mb-4">

    <div class="col-md-6">

        <div class="card bg-primary text-white shadow">

            <div class="card-body">

                <h5>Total Events</h5>

                <h2>@DataStore.Events.Count</h2>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card bg-success text-white shadow">

            <div class="card-body">

                <h5>Total RSVPs</h5>

                <h2>@DataStore.Rsvps.Count</h2>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-md-4 mb-3">

        <div class="card shadow h-100">

            <div class="card-body text-center">

                <i class="fa-solid fa-calendar-plus fa-3x text-primary mb-3"></i>

                <h4>Create Event</h4>

                <p>Create a new invitation.</p>

                <a asp-controller="Event"
                   asp-action="CreateEventPage"
                   class="btn btn-outline-primary w-100">

                    Open

                </a>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card shadow h-100">

            <div class="card-body text-center">

                <i class="fa-solid fa-users fa-3x text-success mb-3"></i>

                <h4>RSVP List</h4>

                <p>View guest responses.</p>

                <a asp-controller="Event"
                   asp-action="RsvpList"
                   class="btn btn-outline-success w-100">

                    Open

                </a>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-3">

        <div class="card shadow h-100">

            <div class="card-body text-center">

                <i class="fa-solid fa-right-from-bracket fa-3x text-danger mb-3"></i>

                <h4>Logout</h4>

                <p>End your session.</p>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="btn btn-outline-danger w-100">

                    Logout

                </a>

            </div>

        </div>

    </div>

</div>